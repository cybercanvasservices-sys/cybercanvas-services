{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybercanvas-services",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cybercanvas-services"
    }
  ],
  "d1_databases": [
    {
      "binding": "CYBERCANVAS_DB",
      "database_name": "cybercanvas-tickets",
      "database_id": "d6747f43-eb38-4c4c-91b0-26fa72dcf73a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
